# /etc/network/interfaces

auto lo
iface lo inet loopback

# Management
auto eth0
iface eth0 inet dhcp

# Internet
auto eth1
iface eth1 inet dhcp
    post-up   iptables -t nat -A POSTROUTING -o eth1 -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -o eth1 -j MASQUERADE
    # Windows Remote Desktop (VM 211)
    post-up   iptables -t nat -A PREROUTING -p tcp -i eth1 --dport 3389 -j DNAT --to-destination 10.10.200.211
    post-down iptables -t nat -D PREROUTING -p tcp -i eth1 --dport 3389 -j DNAT --to-destination 10.10.200.211
    # SSH (CT 100)
    post-up   iptables -t nat -A PREROUTING -p tcp -i eth1 --dport 2200 -j DNAT --to-destination 10.10.200.100:22
    post-down iptables -t nat -D PREROUTING -p tcp -i eth1 --dport 2200 -j DNAT --to-destination 10.10.200.100:22
    post-up   echo 1 > /proc/sys/net/ipv4/ip_forward

# Boards
auto eth2
iface eth2 inet static
    address 10.10.10.1/24

auto vmbr0
iface vmbr0 inet static
    address 10.10.100.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0

auto vmbr1
iface vmbr1 inet static
    address 10.10.200.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
